     "x0": 79.44,
     "x1": 271.52,
     "size": 16.08,
     "text": "空白行，供双方补充约定。",
     "segments": [
      {
       "x0": 79.44,
       "x1": 271.52,
       "text": "空白行，供双方补充约定。"
      }
     ]
    },
    {
     "y": 548.88,
     "x0": 108.69,
     "x1": 521.71,
     "size": 16.08,
     "text": "5、签订合同时，甲乙双方均应向对方提供营业证照、登记",
     "segments": [
      {
       "x0": 108.69,
       "x1": 521.71,
       "text": "5、签订合同时，甲乙双方均应向对方提供营业证照、登记"
      }
