      }
     ]
    },
    {
     "y": 188.88,
     "x0": 108.69,
     "x1": 529.72,
     "size": 16.08,
     "text": "1、本合同范本适用于东莞市行政区域内的农贸市场开办者、",
     "segments": [
      {
       "x0": 108.69,
       "x1": 529.72,
       "text": "1、本合同范本适用于东莞市行政区域内的农贸市场开办者、"
      }
     ]
    },
    {
     "y": 218.88,
     "x0": 79.44,
     "x1": 521.7,
     "size": 16.08,
     "text": "承包者与管理者就管理服务农贸市场所订立的法律文书，是双方",
     "segments": [
      {
       "x0": 79.44,
       "x1": 521.7,
       "text": "承包者与管理者就管理服务农贸市场所订立的法律文书，是双方"
      }
     ]
    },
    {
     "y": 248.88,
     "x0": 79.44,
     "x1": 521.7,
     "size": 16.08,
     "text": "对管理服务农贸市场有关事宜的确认。签订前双方应仔细阅读本",
     "segments": [
      {
       "x0": 79.44,
       "x1": 521.7,
       "text": "对管理服务农贸市场有关事宜的确认。签订前双方应仔细阅读本"
      }
     ]
    },
    {
     "y": 278.88,
     "x0": 79.44,
     "x1": 521.72,
     "size": 16.08,
     "text": "合同内容，对条款及专业用词理解不—致的，可向东莞市市场监",
     "segments": [
      {
       "x0": 79.44,
       "x1": 521.72,
       "text": "合同内容，对条款及专业用词理解不—致的，可向东莞市市场监"
      }
     ]
    },
    {
     "y": 308.88,
     "x0": 79.44,
     "x1": 191.52,
     "size": 16.08,
     "text": "督管理局咨询。",
     "segments": [
      {
       "x0": 79.44,
       "x1": 191.52,
       "text": "督管理局咨询。"
      }
     ]
    },
    {
     "y": 338.88,
     "x0": 108.69,
     "x1": 521.72,
     "size": 16.08,
     "text": "2、本合同所称管理服务是指农贸市场开办者、承包者与管",
     "segments": [
      {
       "x0": 108.69,
       "x1": 521.72,
       "text": "2、本合同所称管理服务是指农贸市场开办者、承包者与管"
      }
     ]
    },
    {
     "y": 368.88,
     "x0": 79.44,
     "x1": 521.72,
     "size": 16.08,
     "text": "理者间订立合同，将农贸市场的“管理服务工作”全部或部分在一",
     "segments": [
      {
       "x0": 79.44,
       "x1": 521.72,
       "text": "理者间订立合同，将农贸市场的“管理服务工作”全部或部分在一"
      }
     ]
    },
    {
     "y": 398.88,
     "x0": 79.44,
     "x1": 511.51,
     "size": 16.08,
     "text": "定期限内委托给管理者，由管理者对农贸市场进行管理服务。",
     "segments": [
      {
       "x0": 79.44,
       "x1": 511.51,
       "text": "定期限内委托给管理者，由管理者对农贸市场进行管理服务。"
      }
     ]
    },
    {
     "y": 428.88,
     "x0": 108.69,
     "x1": 521.72,
     "size": 16.08,
     "text": "3、双方当事人填写的通讯地址、电子邮箱、联系电话等信",
     "segments": [
      {
       "x0": 108.69,
       "x1": 521.72,
       "text": "3、双方当事人填写的通讯地址、电子邮箱、联系电话等信"
      }
     ]
    },
    {
     "y": 458.88,
     "x0": 79.44,
     "x1": 223.52,
     "size": 16.08,
     "text": "息应当真实、准确。",
     "segments": [
      {
       "x0": 79.44,
       "x1": 223.52,
       "text": "息应当真实、准确。"
      }
     ]
    },
    {
