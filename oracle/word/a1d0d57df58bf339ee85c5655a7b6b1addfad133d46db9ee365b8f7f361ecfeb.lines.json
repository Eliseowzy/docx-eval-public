     "x0": 108.69,
     "x1": 521.72,
     "size": 16.08,
     "text": "4、为体现合同双方的自愿原则，本合同范本相关条款留有",
     "segments": [
      {
       "x0": 108.69,
       "x1": 521.72,
       "text": "4、为体现合同双方的自愿原则，本合同范本相关条款留有"
      }
