     "y": 415.7,
     "x0": 111.64,
     "x1": 520.76,
     "size": 16.08,
     "text": "1.明确管理范围。峡口镇农（林）生产自用船舶是指属于企",
     "segments": [
      {
       "x0": 111.64,
       "x1": 520.76,
       "text": "1.明确管理范围。峡口镇农（林）生产自用船舶是指属于企"
      }
     ]
    },
    {
     "y": 444.72,
     "x0": 79.44,
     "x1": 522.52,
     "size": 16.08,
     "text": "业、集体或个人所有的用于农（林）业生产、日常生活，且船长",
     "segments": [
