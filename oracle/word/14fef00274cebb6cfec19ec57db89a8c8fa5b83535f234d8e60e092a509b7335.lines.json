      }
     ]
    },
    {
     "y": 474.24,
     "x0": 111.04,
     "x1": 520.18,
     "size": 16.08,
     "text": "以“安全第一、预防为主、综合治理”为方针，结合峡口镇水",
     "segments": [
      {
       "x0": 111.04,
       "x1": 520.18,
       "text": "以“安全第一、预防为主、综合治理”为方针，结合峡口镇水"
