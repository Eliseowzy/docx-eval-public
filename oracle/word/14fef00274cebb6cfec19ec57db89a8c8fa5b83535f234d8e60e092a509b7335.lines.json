     "x0": 79.44,
     "x1": 521.96,
     "size": 16.08,
     "text": "域特点，全面强化汛期及日常渡口安全管理，提升事故预防、应",
     "segments": [
      {
       "x0": 79.44,
       "x1": 521.96,
       "text": "域特点，全面强化汛期及日常渡口安全管理，提升事故预防、应"
