     "x0": 79.44,
     "x1": 521.97,
     "size": 16.08,
     "text": "急处置和协同联动能力，保障人民群众生命财产安全，确保渡口",
     "segments": [
      {
       "x0": 79.44,
       "x1": 521.97,
       "text": "急处置和协同联动能力，保障人民群众生命财产安全，确保渡口"
      }
     ]
    },
