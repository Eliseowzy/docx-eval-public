     "y": 127.44,
     "x0": 111.04,
     "x1": 537.71,
     "size": 16.08,
     "text": "为做好2025年巩固拓展脱贫攻坚与乡村振兴有效衔接工作，",
     "segments": [
      {
       "x0": 111.04,
       "x1": 537.71,
       "text": "为做好2025年巩固拓展脱贫攻坚与乡村振兴有效衔接工作，"
      }
     ]
    },
    {
     "y": 155.28,
     "x0": 79.44,
     "x1": 529.64,
     "size": 16.08,
     "text": "袁庄镇按照国家、河南省、郑州市及我市有关扶贫政策和规定，",
     "segments": [
      {
       "x0": 79.44,
       "x1": 529.64,
