      }
     ]
    },
    {
     "y": 497.28,
     "x0": 111.04,
     "x1": 521.9,
     "size": 16.08,
     "text": "张华岭村没有工业商贸企业，经济发展缓慢，群众主要收入",
     "segments": [
      {
       "x0": 111.04,
       "x1": 521.9,
       "text": "张华岭村没有工业商贸企业，经济发展缓慢，群众主要收入"
      }
     ]
    },
    {
     "y": 525.36,
     "x0": 79.44,
     "x1": 411.41,
     "size": 16.08,
     "text": "靠外出务工、打零工、种植养殖业为主要来源。",
     "segments": [
