    },
    {
     "y": 183.36,
     "x0": 79.44,
     "x1": 515.52,
     "size": 16.08,
     "text": "编制了《2025年袁庄镇张华岭村道路建设项目实施方案》，申",
     "segments": [
      {
       "x0": 79.44,
       "x1": 515.52,
