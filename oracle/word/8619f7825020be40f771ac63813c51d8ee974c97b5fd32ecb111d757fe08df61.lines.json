     "y": 127.44,
     "x0": 110.94,
     "x1": 524.04,
     "size": 16.08,
     "text": "（1）改善村容村貌的需求。张华岭村因道路年久失修，坑",
     "segments": [
      {
       "x0": 110.94,
       "x1": 524.04,
       "text": "（1）改善村容村貌的需求。张华岭村因道路年久失修，坑"
      }
     ]
    },
    {
     "y": 155.28,
     "x0": 79.44,
     "x1": 512.7,
     "size": 16.08,
     "text": "洼不平，黄土裸露，严重影响了村民的出行，给群众生产生活",
     "segments": [
      {
       "x0": 79.44,
       "x1": 512.7,
       "text": "洼不平，黄土裸露，严重影响了村民的出行，给群众生产生活"
      }
     ]
    },
    {
     "y": 183.36,
     "x0": 79.44,
     "x1": 493.23,
     "size": 16.08,
     "text": "带来不便，道路整修，改变生活居住环境，方便群众出行。",
     "segments": [
      {
       "x0": 79.44,
       "x1": 493.23,
       "text": "带来不便，道路整修，改变生活居住环境，方便群众出行。"
      }
     ]
    },
    {
     "y": 211.44,
     "x0": 110.94,
     "x1": 521.33,
     "size": 16.08,
     "text": "（2）改善乡村形象的需要。通过道路的建设，可以提升我",
     "segments": [
      {
       "x0": 110.94,
       "x1": 521.33,
       "text": "（2）改善乡村形象的需要。通过道路的建设，可以提升我"
      }
     ]
    },
    {
     "y": 239.28,
     "x0": 79.44,
     "x1": 444.7,
     "size": 16.08,
     "text": "村整体居住品质和项目发展，进一步加大群众收入。",
     "segments": [
      {
       "x0": 79.44,
       "x1": 444.7,
       "text": "村整体居住品质和项目发展，进一步加大群众收入。"
      }
     ]
    },
    {
     "y": 267.36,
     "x0": 110.94,
     "x1": 521.93,
     "size": 16.08,
     "text": "（3）项目建成后方便张华岭村群众出行，通过香炉山生态",
     "segments": [
      {
       "x0": 110.94,
       "x1": 521.93,
       "text": "（3）项目建成后方便张华岭村群众出行，通过香炉山生态"
      }
     ]
    },
    {
     "y": 295.44,
     "x0": 79.44,
     "x1": 512.81,
     "size": 16.08,
     "text": "旅游带动本村及周边群众致富。长远打算，可利用道路两侧废",
     "segments": [
      {
       "x0": 79.44,
       "x1": 512.81,
       "text": "旅游带动本村及周边群众致富。长远打算，可利用道路两侧废"
      }
     ]
    },
    {
     "y": 323.28,
     "x0": 79.44,
     "x1": 270.68,
     "size": 16.08,
     "text": "弃工矿用地进行开发建设。",
     "segments": [
      {
       "x0": 79.44,
       "x1": 270.68,
       "text": "弃工矿用地进行开发建设。"
      }
     ]
    },
