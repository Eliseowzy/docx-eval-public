     "y": 351.36,
     "x0": 111.04,
     "x1": 513.55,
     "size": 16.08,
     "text": "（4）方便一组、六组38户120人生产、生活出行。同时",
     "segments": [
      {
       "x0": 111.04,
       "x1": 513.55,
       "text": "（4）方便一组、六组38户120人生产、生活出行。同时"
      }
     ]
    },
