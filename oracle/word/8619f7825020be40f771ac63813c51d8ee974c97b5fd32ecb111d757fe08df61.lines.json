    },
    {
     "y": 301.44,
     "x0": 111.04,
     "x1": 521.92,
     "size": 16.08,
     "text": "张华岭村属于郑州市贫困村，2020年12月退出贫困村。张",
     "segments": [
      {
       "x0": 111.04,
       "x1": 521.92,
       "text": "张华岭村属于郑州市贫困村，2020年12月退出贫困村。张"
      }
     ]
    },
    {
     "y": 329.28,
     "x0": 79.44,
     "x1": 521.78,
     "size": 16.08,
     "text": "华岭村位于袁庄乡西北方向，距市区8公里左右，全村面积3.5",
     "segments": [
      {
       "x0": 79.44,
       "x1": 521.78,
       "text": "华岭村位于袁庄乡西北方向，距市区8公里左右，全村面积3.5"
      }
     ]
    },
    {
     "y": 357.36,
     "x0": 79.44,
     "x1": 521.78,
     "size": 16.08,
     "text": "平方公里左右。有8个村民小组，185户，681口人。监测户5",
     "segments": [
      {
       "x0": 79.44,
       "x1": 521.78,
       "text": "平方公里左右。有8个村民小组，185户，681口人。监测户5"
      }
     ]
    },
    {
     "y": 385.44,
     "x0": 79.44,
     "x1": 529.82,
     "size": 16.08,
     "text": "户12人。全村为丘陵地形，80%的耕地属于坡岗地，均为旱地，",
     "segments": [
      {
       "x0": 79.44,
       "x1": 529.82,
       "text": "户12人。全村为丘陵地形，80%的耕地属于坡岗地，均为旱地，"
      }
     ]
    },
    {
     "y": 413.28,
     "x0": 79.44,
     "x1": 521.78,
     "size": 16.08,
     "text": "全村耕地面积400亩，退耕还林面积800亩左右，荒山面积2500",
     "segments": [
      {
       "x0": 79.44,
       "x1": 521.78,
       "text": "全村耕地面积400亩，退耕还林面积800亩左右，荒山面积2500"
      }
     ]
    },
    {
     "y": 441.36,
     "x0": 79.44,
     "x1": 358.51,
     "size": 16.08,
     "text": "亩左右，张华岭村有水果番茄大棚6个。",
     "segments": [
      {
       "x0": 79.44,
       "x1": 358.51,
       "text": "亩左右，张华岭村有水果番茄大棚6个。"
      }
     ]
    },
    {
     "y": 469.44,
     "x0": 111.04,
     "x1": 237.68,
     "size": 16.08,
     "text": "（二）产业概况。",
     "segments": [
