    },
    {
     "y": 211.44,
     "x0": 79.44,
     "x1": 529.64,
     "size": 16.08,
     "text": "报道路建设项目一个，新修张华岭村道路5段共长1000.38米，",
     "segments": [
      {
       "x0": 79.44,
       "x1": 529.64,
       "text": "报道路建设项目一个，新修张华岭村道路5段共长1000.38米，"
      }
     ]
    },
    {
     "y": 239.28,
     "x0": 79.44,
     "x1": 498.27,
     "size": 16.08,
     "text": "道路均宽3.5米，均采用15厘米厚C25水泥砼路面，总面积",
     "segments": [
      {
       "x0": 79.44,
       "x1": 498.27,
       "text": "道路均宽3.5米，均采用15厘米厚C25水泥砼路面，总面积"
