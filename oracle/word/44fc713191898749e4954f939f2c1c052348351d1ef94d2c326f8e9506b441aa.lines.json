    },
    {
     "y": 313.44,
     "x0": 79.44,
     "x1": 479.75,
     "size": 16.08,
     "text": "乡建设主管部门设计审查和竣工验收而擅自投入使用的；",
     "segments": [
      {
       "x0": 79.44,
       "x1": 479.75,
       "text": "乡建设主管部门设计审查和竣工验收而擅自投入使用的；"
