       "x0": 79.44,
       "x1": 351.76,
       "text": "违法所得的可处以10000元以下罚款。"
      }
     ]
    },
    {
     "y": 282.24,
     "x0": 111.44,
     "x1": 521.93,
     "size": 16.08,
     "text": "（一）新建、改建、扩建的饮用水供水工程项目未经住房城",
     "segments": [
      {
       "x0": 111.44,
       "x1": 521.93,
       "text": "（一）新建、改建、扩建的饮用水供水工程项目未经住房城"
      }
