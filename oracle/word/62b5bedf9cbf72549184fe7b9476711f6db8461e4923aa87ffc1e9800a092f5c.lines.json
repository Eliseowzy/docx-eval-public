      }
     ]
    },
    {
     "y": 361.68,
     "x0": 108.69,
     "x1": 521.71,
     "size": 16.08,
     "text": "1、本合同范本适用于东莞市行政区域内的农贸市场出租者",
     "segments": [
      {
       "x0": 108.69,
       "x1": 521.71,
       "text": "1、本合同范本适用于东莞市行政区域内的农贸市场出租者"
      }
     ]
    },
    {
     "y": 391.68,
     "x0": 79.44,
     "x1": 521.72,
     "size": 16.08,
     "text": "与承租者就租赁农贸市场摊档、铺位所订立的法律文书，是双方",
     "segments": [
      {
       "x0": 79.44,
       "x1": 521.72,
       "text": "与承租者就租赁农贸市场摊档、铺位所订立的法律文书，是双方"
      }
     ]
    },
    {
     "y": 421.68,
     "x0": 79.44,
     "x1": 521.72,
     "size": 16.08,
     "text": "对租赁农贸市场摊档、铺位有关事宜的确认。签订前双方应仔细",
     "segments": [
      {
       "x0": 79.44,
       "x1": 521.72,
       "text": "对租赁农贸市场摊档、铺位有关事宜的确认。签订前双方应仔细"
      }
     ]
    },
    {
     "y": 451.68,
     "x0": 79.44,
     "x1": 521.72,
     "size": 16.08,
     "text": "阅读本合同内容，对条款及专业用词理解不—致的，可向东莞市",
     "segments": [
      {
       "x0": 79.44,
       "x1": 521.72,
       "text": "阅读本合同内容，对条款及专业用词理解不—致的，可向东莞市"
      }
     ]
    },
    {
     "y": 481.68,
     "x0": 79.44,
     "x1": 207.52,
     "size": 16.08,
     "text": "市场监管局咨询。",
     "segments": [
      {
       "x0": 79.44,
       "x1": 207.52,
       "text": "市场监管局咨询。"
      }
     ]
    },
    {
     "y": 519.6,
     "x0": 111.44,
     "x1": 521.67,
     "size": 16.08,
     "text": "2、本合同所称出租者是指对农贸市场摊档、铺位享有占有、",
     "segments": [
      {
       "x0": 111.44,
       "x1": 521.67,
       "text": "2、本合同所称出租者是指对农贸市场摊档、铺位享有占有、"
      }
     ]
    },
    {
     "y": 549.6,
     "x0": 79.44,
     "x1": 521.7,
     "size": 16.08,
     "text": "使用和收益权的农贸市场开办者或承包者。承租者是以支付租金",
     "segments": [
      {
       "x0": 79.44,
       "x1": 521.7,
       "text": "使用和收益权的农贸市场开办者或承包者。承租者是以支付租金"
      }
     ]
    },
    {
     "y": 579.6,
     "x0": 79.44,
     "x1": 521.72,
     "size": 16.08,
     "text": "方式租赁农贸市场摊档、铺位用于从事经营活动的自然人、个体",
     "segments": [
      {
       "x0": 79.44,
       "x1": 521.72,
       "text": "方式租赁农贸市场摊档、铺位用于从事经营活动的自然人、个体"
      }
     ]
    },
    {
     "y": 609.6,
     "x0": 79.44,
     "x1": 159.52,
     "size": 16.08,
     "text": "户或企业。",
     "segments": [
      {
       "x0": 79.44,
       "x1": 159.52,
       "text": "户或企业。"
      }
     ]
    },
    {
     "y": 647.76,
     "x0": 111.44,
     "x1": 521.72,
     "size": 16.08,
     "text": "3、双方当事人填写的通讯地址、电子邮箱、联系电话等信",
     "segments": [
      {
       "x0": 111.44,
       "x1": 521.72,
       "text": "3、双方当事人填写的通讯地址、电子邮箱、联系电话等信"
      }
     ]
    },
    {
     "y": 677.76,
     "x0": 79.44,
     "x1": 223.52,
     "size": 16.08,
     "text": "息应当真实、准确。",
     "segments": [
      {
       "x0": 79.44,
       "x1": 223.52,
       "text": "息应当真实、准确。"
      }
     ]
    },
