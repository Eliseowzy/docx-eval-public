     ]
    },
    {
     "y": 237.84,
     "x0": 79.44,
     "x1": 521.93,
     "size": 16.08,
     "text": "风险较大，巩固脱贫成果任务依然艰巨。为解决本村产业发展与",
     "segments": [
      {
       "x0": 79.44,
       "x1": 521.93,
       "text": "风险较大，巩固脱贫成果任务依然艰巨。为解决本村产业发展与"
      }
     ]
    },
    {
     "y": 272.88,
     "x0": 79.44,
     "x1": 529.68,
     "size": 16.08,
     "text": "群众土地耕作难问题，依托本村的自然环境风貌，经现场勘查，",
     "segments": [
