      }
     ]
    },
    {
     "y": 426.0,
     "x0": 90.0,
     "x1": 505.38,
     "size": 16.08,
     "text": "册地址填写企业营业执照上载明的注册地址;联系电话填",
     "segments": [
      {
       "x0": 90.0,
       "x1": 505.38,
       "text": "册地址填写企业营业执照上载明的注册地址;联系电话填"
