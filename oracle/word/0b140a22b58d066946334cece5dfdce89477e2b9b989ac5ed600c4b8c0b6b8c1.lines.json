  },
  {
   "width": 595.2,
   "height": 841.92,
   "lines": [
    {
     "y": 96.0,
     "x0": 90.0,
     "x1": 505.36,
     "size": 16.08,
     "text": "农牧民工不建议签订固定期限和无固定期限的劳动合同。但",
     "segments": [
      {
       "x0": 90.0,
       "x1": 505.36,
       "text": "农牧民工不建议签订固定期限和无固定期限的劳动合同。但"
      }
     ]
    },
    {
     "y": 126.0,
     "x0": 90.0,
     "x1": 505.39,
     "size": 16.08,
     "text": "如果有一些工种或个人确需签订固定期限和无固定期限劳",
     "segments": [
      {
       "x0": 90.0,
       "x1": 505.39,
       "text": "如果有一些工种或个人确需签订固定期限和无固定期限劳"
      }
     ]
    },
    {
     "y": 156.0,
     "x0": 90.0,
     "x1": 505.38,
     "size": 16.08,
     "text": "动合同的,劳动合同期限三个月以上不满一年的,试用期",
     "segments": [
      {
       "x0": 90.0,
       "x1": 505.38,
       "text": "动合同的,劳动合同期限三个月以上不满一年的,试用期"
      }
     ]
    },
    {
     "y": 186.0,
     "x0": 90.0,
     "x1": 505.38,
     "size": 16.08,
     "text": "不得超过一个月;劳动合同期限一年以上不满三年的,试",
     "segments": [
      {
       "x0": 90.0,
       "x1": 505.38,
       "text": "不得超过一个月;劳动合同期限一年以上不满三年的,试"
      }
     ]
    },
    {
     "y": 216.0,
     "x0": 90.0,
     "x1": 505.38,
     "size": 16.08,
     "text": "用期不得超过二个月;三年以上固定期限和无固定期限的",
     "segments": [
      {
       "x0": 90.0,
       "x1": 505.38,
       "text": "用期不得超过二个月;三年以上固定期限和无固定期限的"
      }
     ]
    },
    {
     "y": 246.0,
     "x0": 90.0,
     "x1": 505.38,
     "size": 16.08,
     "text": "劳动合同,试用期不得超过六个月。双方约定的试用期工",
     "segments": [
      {
       "x0": 90.0,
       "x1": 505.38,
       "text": "劳动合同,试用期不得超过六个月。双方约定的试用期工"
      }
     ]
    },
    {
     "y": 276.0,
     "x0": 90.0,
     "x1": 505.39,
     "size": 16.08,
     "text": "资不得低于甲方相同岗位最低档工资或者合同约定工资的",
     "segments": [
      {
       "x0": 90.0,
       "x1": 505.39,
       "text": "资不得低于甲方相同岗位最低档工资或者合同约定工资的"
      }
     ]
    },
    {
     "y": 306.0,
     "x0": 90.0,
     "x1": 474.07,
     "size": 16.08,
     "text": "百分之八十,并不得低于乙方工作地的最低工资标准。",
     "segments": [
      {
       "x0": 90.0,
       "x1": 474.07,
       "text": "百分之八十,并不得低于乙方工作地的最低工资标准。"
      }
     ]
    },
    {
     "y": 336.0,
     "x0": 122.0,
     "x1": 505.38,
     "size": 16.08,
     "text": "三、工作岗位填写具体工种,如“力工”、“木工”、“钢",
     "segments": [
      {
       "x0": 122.0,
       "x1": 505.38,
       "text": "三、工作岗位填写具体工种,如“力工”、“木工”、“钢"
      }
     ]
    },
    {
     "y": 366.0,
     "x0": 90.0,
     "x1": 505.37,
     "size": 16.08,
     "text": "筋工”等等,这些信息要和考勤表、工资表等载明个人信息",
     "segments": [
      {
       "x0": 90.0,
       "x1": 505.37,
       "text": "筋工”等等,这些信息要和考勤表、工资表等载明个人信息"
