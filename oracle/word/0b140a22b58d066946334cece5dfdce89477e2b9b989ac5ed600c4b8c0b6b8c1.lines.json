    },
    {
     "y": 396.0,
     "x0": 90.0,
     "x1": 218.08,
     "size": 16.08,
     "text": "的资料保持一致。",
     "segments": [
      {
       "x0": 90.0,
       "x1": 218.08,
       "text": "的资料保持一致。"
      }
     ]
    },
    {
     "y": 426.0,
     "x0": 122.0,
     "x1": 505.37,
     "size": 16.08,
     "text": "四、工时制度有三个选项,分别是标准工时制度、综合",
     "segments": [
      {
       "x0": 122.0,
       "x1": 505.37,
       "text": "四、工时制度有三个选项,分别是标准工时制度、综合"
      }
     ]
    },
    {
     "y": 456.0,
     "x0": 90.0,
     "x1": 505.38,
     "size": 16.08,
     "text": "计算工时制度和不定时工时制度,后两项必须经当地人社",
     "segments": [
      {
       "x0": 90.0,
       "x1": 505.38,
       "text": "计算工时制度和不定时工时制度,后两项必须经当地人社"
      }
     ]
    },
    {
     "y": 486.0,
     "x0": 90.0,
     "x1": 505.38,
     "size": 16.08,
     "text": "部门审批后才能选择,凡未经审批的一律选择实行标准工",
     "segments": [
      {
       "x0": 90.0,
       "x1": 505.38,
       "text": "部门审批后才能选择,凡未经审批的一律选择实行标准工"
      }
     ]
    },
