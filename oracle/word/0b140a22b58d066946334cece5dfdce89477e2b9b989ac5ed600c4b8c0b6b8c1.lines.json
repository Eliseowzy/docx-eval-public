    },
    {
     "y": 606.0,
     "x0": 90.0,
     "x1": 490.08,
     "size": 16.08,
     "text": "可按每月计酬的农牧民工选择此种计酬方式,如填写月工",
     "segments": [
      {
       "x0": 90.0,
       "x1": 490.08,
       "text": "可按每月计酬的农牧民工选择此种计酬方式,如填写月工"
      }
     ]
    },
    {
     "y": 636.0,
     "x0": 90.0,
     "x1": 502.07,
     "size": 16.08,
     "text": "资4000元;二是日工资,建议力工等按日计酬的农牧民工",
     "segments": [
      {
       "x0": 90.0,
       "x1": 502.07,
       "text": "资4000元;二是日工资,建议力工等按日计酬的农牧民工"
      }
     ]
    },
    {
     "y": 666.0,
     "x0": 90.0,
     "x1": 513.34,
     "size": 16.08,
     "text": "选择此种计酬方式,如填写日工资150元;三是计件工资,",
     "segments": [
      {
       "x0": 90.0,
       "x1": 513.34,
       "text": "选择此种计酬方式,如填写日工资150元;三是计件工资,"
      }
     ]
    },
    {
     "y": 696.0,
