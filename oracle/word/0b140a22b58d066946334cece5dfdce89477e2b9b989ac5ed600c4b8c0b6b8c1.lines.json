      }
     ]
    },
    {
     "y": 546.0,
     "x0": 122.0,
     "x1": 498.08,
     "size": 16.08,
     "text": "五、劳动报酬:工资标准应按双方商定的填写,计酬方",
     "segments": [
      {
       "x0": 122.0,
       "x1": 498.08,
       "text": "五、劳动报酬:工资标准应按双方商定的填写,计酬方"
