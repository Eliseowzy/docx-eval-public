     "x1": 505.38,
     "size": 16.08,
     "text": "系电话填写农牧民工本人在用电话号码,要和工资表上电",
     "segments": [
      {
       "x0": 90.0,
       "x1": 505.38,
       "text": "系电话填写农牧民工本人在用电话号码,要和工资表上电"
