     "y": 456.0,
     "x0": 90.0,
     "x1": 282.08,
     "size": 16.08,
     "text": "写本企业劳资员电话号码。",
     "segments": [
      {
       "x0": 90.0,
       "x1": 282.08,
       "text": "写本企业劳资员电话号码。"
      }
     ]
    },
    {
     "y": 486.0,
     "x0": 122.0,
     "x1": 505.38,
     "size": 16.08,
     "text": "2、乙方的情况:乙方(劳动者)姓名按居民身份证实际情",
     "segments": [
