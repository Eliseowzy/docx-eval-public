     "x0": 90.0,
     "x1": 505.38,
     "size": 16.08,
     "text": "况填写;居民身份证号码按居民身份证实际情况填写;联",
     "segments": [
      {
       "x0": 90.0,
       "x1": 505.38,
       "text": "况填写;居民身份证号码按居民身份证实际情况填写;联"
