    },
    {
     "y": 492.72,
     "x0": 122.0,
     "x1": 505.38,
     "size": 16.08,
     "text": "袁庄镇富民路社区是新密市委、市政府在2002年为彻",
     "segments": [
      {
       "x0": 122.0,
       "x1": 505.38,
       "text": "袁庄镇富民路社区是新密市委、市政府在2002年为彻"
      }
     ]
    },
    {
     "y": 523.92,
     "x0": 90.0,
     "x1": 505.38,
     "size": 16.08,
     "text": "底解决贫困人口的脱贫致富的问题，按照“新世纪、新扶贫，",
     "segments": [
      {
       "x0": 90.0,
       "x1": 505.38,
       "text": "底解决贫困人口的脱贫致富的问题，按照“新世纪、新扶贫，"
      }
