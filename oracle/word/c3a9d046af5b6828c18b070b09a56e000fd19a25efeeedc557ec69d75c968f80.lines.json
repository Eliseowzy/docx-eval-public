    },
    {
     "y": 555.12,
     "x0": 90.0,
     "x1": 505.35,
     "size": 16.08,
     "text": "要有新思路、新举措”的总体要求，组建了郑州市袁庄乡综",
     "segments": [
      {
       "x0": 90.0,
       "x1": 505.35,
       "text": "要有新思路、新举措”的总体要求，组建了郑州市袁庄乡综"
