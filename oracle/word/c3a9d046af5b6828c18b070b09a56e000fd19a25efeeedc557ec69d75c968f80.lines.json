     "x0": 90.0,
     "x1": 505.36,
     "size": 16.08,
     "text": "合扶贫开发区，实施的综合扶贫开发项目。富民路社区被富",
     "segments": [
      {
       "x0": 90.0,
       "x1": 505.36,
       "text": "合扶贫开发区，实施的综合扶贫开发项目。富民路社区被富"
      }
     ]
    },
    {
     "y": 617.52,
     "x0": 90.0,
     "x1": 505.38,
     "size": 16.08,
