       "x0": 76.56,
       "x1": 140.64,
       "text": "理保险。"
      }
     ]
    },
    {
     "y": 502.32,
     "x0": 108.56,
     "x1": 204.64,
     "size": 16.08,
     "text": "四、筹资政策",
     "segments": [
      {
       "x0": 108.56,
       "x1": 204.64,
       "text": "四、筹资政策"
      }
     ]
    },
    {
     "y": 531.12,
     "x0": 108.56,
     "x1": 518.84,
     "size": 16.08,
     "text": "（一）单位职工。单位职工由用人单位和个人共同缴费，费",
     "segments": [
      {
       "x0": 108.56,
       "x1": 518.84,
       "text": "（一）单位职工。单位职工由用人单位和个人共同缴费，费"
      }
     ]
    },
    {
     "y": 559.92,
     "x0": 76.56,
     "x1": 518.84,
     "size": 16.08,
     "text": "率按同比例分担，缴费基数与基本医保一致。2026年至2028年",
     "segments": [
      {
       "x0": 76.56,
       "x1": 518.84,
       "text": "率按同比例分担，缴费基数与基本医保一致。2026年至2028年"
      }
     ]
    },
    {
     "y": 588.72,
     "x0": 76.56,
     "x1": 516.72,
     "size": 16.08,
     "text": "单位职工筹资政策保持现行标准不变。自2029年1月1日起，",
     "segments": [
      {
       "x0": 76.56,
       "x1": 516.72,
       "text": "单位职工筹资政策保持现行标准不变。自2029年1月1日起，"
      }
     ]
    },
    {
     "y": 617.52,
     "x0": 76.56,
     "x1": 479.3,
     "size": 16.08,
     "text": "单位职工费率调整为0.25%（单位和个人各为0.125%）。",
     "segments": [
      {
       "x0": 76.56,
       "x1": 479.3,
       "text": "单位职工费率调整为0.25%（单位和个人各为0.125%）。"
      }
     ]
    },
    {
     "y": 646.32,
     "x0": 108.56,
     "x1": 526.76,
     "size": 16.08,
     "text": "（二）退休人员。退休人员费率与单位职工个人费率相同，",
     "segments": [
      {
       "x0": 108.56,
       "x1": 526.76,
       "text": "（二）退休人员。退休人员费率与单位职工个人费率相同，"
      }
     ]
    },
    {
     "y": 675.12,
     "x0": 76.56,
     "x1": 519.0,
     "size": 16.08,
     "text": "由个人缴费，原用人单位不缴费。过渡期内缴费基数按现行规定",
     "segments": [
      {
       "x0": 76.56,
       "x1": 519.0,
       "text": "由个人缴费，原用人单位不缴费。过渡期内缴费基数按现行规定"
      }
     ]
    },
    {
     "y": 703.92,
     "x0": 76.56,
     "x1": 526.77,
     "size": 16.08,
     "text": "执行，过渡期结束后按国家要求逐步调整到与基本养老金挂钩。",
     "segments": [
      {
       "x0": 76.56,
       "x1": 526.77,
       "text": "执行，过渡期结束后按国家要求逐步调整到与基本养老金挂钩。"
      }
     ]
    },
