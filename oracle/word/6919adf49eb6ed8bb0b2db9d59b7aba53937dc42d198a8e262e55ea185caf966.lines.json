       "x0": 108.56,
       "x1": 204.64,
       "text": "三、制度安排"
      }
     ]
    },
    {
     "y": 358.32,
     "x0": 108.56,
     "x1": 518.84,
     "size": 16.08,
     "text": "用人单位及其单位职工、退休人员、灵活就业人员和未就业",
     "segments": [
