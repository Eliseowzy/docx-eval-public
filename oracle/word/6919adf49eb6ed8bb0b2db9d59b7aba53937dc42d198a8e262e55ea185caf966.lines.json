     "y": 300.72,
     "x0": 76.56,
     "x1": 518.82,
     "size": 16.08,
     "text": "遇公平、管理科学、安全规范、可持续的长期护理保险制度体系。",
     "segments": [
      {
       "x0": 76.56,
       "x1": 518.82,
       "text": "遇公平、管理科学、安全规范、可持续的长期护理保险制度体系。"
