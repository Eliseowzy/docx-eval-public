     "x0": 76.56,
     "x1": 518.84,
     "size": 16.08,
     "text": "资金统筹使用。实行制度政策统一、基金统收统支、管理服务一",
     "segments": [
      {
       "x0": 76.56,
       "x1": 518.84,
       "text": "资金统筹使用。实行制度政策统一、基金统收统支、管理服务一"
      }
     ]
    },
    {
     "y": 444.72,
     "x0": 76.56,
     "x1": 518.84,
     "size": 16.08,
     "text": "体的市级统筹。参加我市基本医疗保险的人员，同步参加长期护",
     "segments": [
      {
       "x0": 76.56,
       "x1": 518.84,
       "text": "体的市级统筹。参加我市基本医疗保险的人员，同步参加长期护"
      }
